# Copy to a private .env; never commit actual credentials.
# Generate a new random value: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required, deliberately blank: startup must fail until configured.
ROBOPLANTER_CLOUD_TOKEN=
ROBOPLANTER_ROOT_PATH=/roboplanter
ROBOPLANTER_ALLOWED_HOSTS=emqx.robomon.cn,emqx.robomon.cn:443,127.0.0.1:18765,localhost:18765,127.0.0.1:8765
ROBOPLANTER_ALLOWED_ORIGINS=https://emqx.robomon.cn

# Cloud account: subscribe reply/presence and publish query only for this device.
# Never reuse the HTTP bearer as a broker password. TLS verification is mandatory.
ROBOPLANTER_MQTT_HOST=mqtt.robomon.cn
ROBOPLANTER_MQTT_PORT=8883
ROBOPLANTER_MQTT_USERNAME=roboplanter-cloud
ROBOPLANTER_MQTT_PASSWORD=
ROBOPLANTER_MQTT_DEVICE_ID=roboplanter-01
# Optional private CA path inside the container; otherwise use system trust.
# ROBOPLANTER_MQTT_CA_FILE=/run/secrets/broker-ca.pem
